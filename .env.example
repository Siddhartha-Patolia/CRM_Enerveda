TELEGRAM_BOT_TOKEN=
GOOGLE_GEMINI_API_KEY=

# OAuth client used for BOTH Gmail sending and Google Sheets logging
# (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Desktop app)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Where the cached OAuth token is stored after the first one-time browser login. Default is fine.
OAUTH_TOKEN_PATH=secrets/token.json

GOOGLE_SHEETS_ID=
SENDER_EMAIL=

# Meta WhatsApp Cloud API (App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NO_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
