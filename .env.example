TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs of staff allowed to use the bot (get yours from
# @userinfobot). Leave empty to allow anyone.
ALLOWED_TELEGRAM_USER_IDS=
GOOGLE_GEMINI_API_KEY=

GOOGLE_SHEETS_ID=

# Sheets logging: crm-sheets service account (Cloud Console -> IAM & Admin -> Service
# Accounts -> Keys -> JSON), shared on the sheet as Editor via its client_email.
# Locally, save the key as secrets/sheets_service_account.json. On servers (Railway), paste
# the file's whole contents here instead.
SHEETS_SERVICE_ACCOUNT_JSON=

# Outreach email via the Gmail API as a Workspace mailbox (replies go to its inbox).
# Create the token once: put the Desktop OAuth client JSON at secrets/oauth_client.json and
# run `python -m scripts.gmail_login`. Locally the token is read from secrets/gmail_token.json;
# on servers (Railway), paste that file's whole contents into GMAIL_TOKEN_JSON.
SENDER_EMAIL=
GMAIL_TOKEN_JSON=
SENDER_NAME=Enerveda Vault LLP
# Optional: Reply-To address, and comma-separated CC / BCC lists added to every email.
REPLY_TO_EMAIL=
EMAIL_CC=
EMAIL_BCC=

# Meta WhatsApp Cloud API (App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NO_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook service only (webhook/app.py): any string; enter the same one as the
# "Verify token" in the App Dashboard's webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
